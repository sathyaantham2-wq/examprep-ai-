# Postgres connection string (Supabase project, pooled connection recommended for the app;
# use the direct connection for running migrations).
#
# This is the database the DEV SERVER uses. Tests do NOT use it: they read .env.test and refuse
# to run against any non-local host (vitest.setup.ts). See .env.test.example.
DATABASE_URL=postgres://user:password@host:5432/postgres

# better-auth session signing secret. Generate one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional — Google sign-in is skipped until both are set (see src/lib/auth.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — AI features (marking written answers, writing questions, revision notes) need AT
# LEAST ONE of these five keys. Without any, written answers wait for a parent to mark them.
#   Anthropic (Claude):  https://console.anthropic.com          -> API Keys  (paid, best quality)
#   Google Gemini:       https://aistudio.google.com/apikey       (free tier; can be slow/rate-limited)
#   Groq:                https://console.groq.com/keys            (free tier; very fast inference)
#   Cerebras:             https://cloud.cerebras.ai                (free tier; very fast inference)
#   OpenRouter:           https://openrouter.ai/keys                (aggregator, many hosted models)
# 2026-09-24: any number of these can be set at once and are tried as an automatic fallback chain,
# not just one vendor at a time -- if the first configured vendor errors or times out, the next
# one is tried automatically. Priority order (fastest/most reliable first, unconfigured ones
# skipped): Groq, Cerebras, Anthropic, OpenRouter, Gemini. AI_PROVIDER, if set, forces exactly one
# vendor instead of the chain.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# AI_PROVIDER=gemini
# Optional per-vendor model overrides (defaults are each vendor's own fast/cheap general-purpose
# model as of 2026-09-24 -- see src/lib/ai-models.ts's own comments for how each was confirmed).
# GEMINI_MODEL_STRONG=
# GEMINI_MODEL_CHEAP=
# GROQ_MODEL_STRONG=
# GROQ_MODEL_CHEAP=
# CEREBRAS_MODEL_STRONG=
# CEREBRAS_MODEL_CHEAP=
# OPENROUTER_MODEL_STRONG=
# OPENROUTER_MODEL_CHEAP=
# On a paid plan with any of these, set real prices (USD per 1M tokens) so the spend caps (F121)
# count that vendor's calls -- every vendor here defaults to 0 (free tier) except Anthropic.
# GEMINI_USD_PER_1M_INPUT=
# GEMINI_USD_PER_1M_OUTPUT=
# GROQ_USD_PER_1M_INPUT=
# GROQ_USD_PER_1M_OUTPUT=
# CEREBRAS_USD_PER_1M_INPUT=
# CEREBRAS_USD_PER_1M_OUTPUT=
# OPENROUTER_USD_PER_1M_INPUT=
# OPENROUTER_USD_PER_1M_OUTPUT=
