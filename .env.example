# Postgres connection string (Supabase project, pooled connection recommended for the app;
# use the direct connection for running migrations).
DATABASE_URL=postgres://user:password@host:5432/postgres

# better-auth session signing secret. Generate one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional — Google sign-in is skipped until both are set (see src/lib/auth.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — AI features (marking written answers, writing questions, revision notes) need ONE of
# these two keys. Without either, written answers wait for a parent to mark them.
#   Anthropic (Claude):  https://console.anthropic.com  -> API Keys   (paid, best marking quality)
#   Google Gemini:       https://aistudio.google.com/apikey            (has a free tier)
# If both are set, Anthropic is used unless AI_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# AI_PROVIDER=gemini
# Optional Gemini overrides (defaults: gemini-2.5-flash and gemini-2.5-flash-lite).
# GEMINI_MODEL_STRONG=
# GEMINI_MODEL_CHEAP=
# On a paid Gemini plan, set real prices (USD per 1M tokens) so the spend caps count Gemini calls.
# GEMINI_USD_PER_1M_INPUT=
# GEMINI_USD_PER_1M_OUTPUT=
