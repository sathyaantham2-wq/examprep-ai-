# Local test database -- copy this file to .env.test and adjust the password/port if needed.
#
# vitest.setup.ts loads .env.test in preference to .env, and REFUSES to run the suite if this
# host is not local. The integration tests create and delete fixture rows, so they must never
# touch the database that serves real users (they did until 2026-09-23; see CLAUDE.md).
#
# One-time setup:
#   1. Install Postgres 17 locally, or: docker run --name examprep-test -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:17
#   2. Create the database:   createdb -U postgres examprep_test        (or via psql: CREATE DATABASE examprep_test;)
#   3. cp .env.test.example .env.test
#   4. npm run db:setup:test
DATABASE_URL=postgres://postgres:postgres@localhost:5432/examprep_test

# These only need to be non-empty for the suite to boot -- nothing here signs a real session.
BETTER_AUTH_SECRET=test-secret-not-used-for-anything-real
BETTER_AUTH_URL=http://localhost:3000

# Leave AI keys unset: tests must not make paid API calls. The code degrades gracefully without
# them (written answers fall back to "needs manual marking"), which is what the suite expects.
